{
  "name": "proactive-ui-for-ai-glasses",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @lumen/web dev",
    "build": "pnpm typecheck && pnpm --filter @lumen/web build",
    "preview": "pnpm --filter @lumen/web preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "eval": "tsx packages/evals/src/run.ts",
    "record": "tsx packages/evals/src/record.ts",
    "shot": "tsx scripts/shot.ts",
    "shots": "tsx scripts/shots.ts"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@types/node": "22",
    "eslint": "10.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
